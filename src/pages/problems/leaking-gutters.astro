---
import Layout from '../../layouts/Layout.astro';
const phone = '+17035550199';
const phoneDisplay = '(703) 555-0199';
---
<Layout title="Leaking Gutters Woodbridge, VA | Seal & Repair" description="Leaking gutters in Woodbridge? We seal seams, replace damaged sections, and stop water damage. Call (703) 555-0199.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> → Problems → Leaking Gutters</div>
      <h1>Leaking Gutters in Woodbridge</h1>
      <p>Water dripping from seams or joints signals holes, loose hangers, or failed sealant. Act before foundation damage spreads.</p>
    </div>
  </section>
  <section class="section">
    <div class="container content-block">
      <p>Common leak sources include separated seams, corroded sections, and failed end caps. We locate the source, seal or replace as needed, and verify the system holds water.</p>
      <div style="margin-top:2rem;text-align:center"><a href={`tel:${phone}`} class="btn btn-primary">Call {phoneDisplay}</a></div>
    </div>
  </section>
</Layout>
