---
import Layout from '../../layouts/Layout.astro';
const phone = '+17035550199';
const phoneDisplay = '(703) 555-0199';
---
<Layout title="Emergency Gutter Repair Woodbridge, VA | Storm Damage" description="Fast emergency gutter repair in Woodbridge, VA after storms or collapses. Same-day response when possible. Call (703) 555-0199.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> → <a href="/#services">Services</a> → Emergency Repair</div>
      <h1>Emergency Gutter Repair in Woodbridge</h1>
      <p>Storm damage, collapsed sections, or active leaks — we respond fast to protect your home.</p>
    </div>
  </section>
  <section class="section">
    <div class="container content-block">
      <h2>When to Call for Emergency Service</h2>
      <ul>
        <li>Gutters pulled away or hanging after high winds</li>
        <li>Active leaking onto siding or into the structure</li>
        <li>Collapsed or crushed sections blocking drainage</li>
        <li>Downspouts disconnected and dumping at the foundation</li>
      </ul>
      <p>We prioritize safety and temporary securing when needed, then complete permanent repairs as soon as materials and conditions allow. Pricing is discussed upfront with no after-hours surprise fees.</p>
      <div style="margin-top:2rem;text-align:center">
        <a href={`tel:${phone}`} class="btn btn-primary">Call {phoneDisplay} Now</a>
      </div>
    </div>
  </section>
</Layout>
